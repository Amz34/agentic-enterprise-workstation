{
  "name": "Agentic Enterprise Workstation (AEW)",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.vscode-pull-request-github"
      ]
    }
  },
  "forwardPorts": [8000],
  "postCreateCommand": "git config --global --add safe.directory /workspace",
  "remoteUser": "root"
}
